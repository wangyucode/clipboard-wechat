/**index.wxss**/

page {
  margin: 0;
  padding: 0;
  background-color: #f8fafc;
  box-sizing: border-box;
}

.container {
  display: flex;
  flex-direction: column;
  padding: 24rpx;
  box-sizing: border-box;
  gap: 20rpx;
  position: static;
  inset: auto;
  margin: 0;
}

/* 查询码卡片 */
.query-id-box {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #edf2f7;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.query-id-left {
  display: flex;
  flex-direction: column;
}

.query-id-label {
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.btn-copy-action {
  font-size: 26rpx;
  font-weight: 600;
  color: #379392;
  background-color: rgba(55, 147, 146, 0.12);
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(55, 147, 146, 0.2);
  transition: all 0.2s;
}

.text-query-id {
  color: #379392;
  font-size: 68rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
  line-height: 1.1;
}

/* 锁定/解密面板 */
.lock-panel {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #edf2f7;
  flex: 1;
  justify-content: center;
}

.lock-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 8rpx;
}

.lock-desc {
  font-size: 24rpx;
  color: #718096;
  margin-bottom: 32rpx;
  text-align: center;
}

/* 密码输入框与眼睛按钮封装 */
.pwd-input-wrap {
  width: 100%;
  display: flex;
  align-items: center;
  background: #f7fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  box-sizing: border-box;
  padding: 0 16rpx 0 24rpx;
  margin-bottom: 24rpx;
}

.pwd-input {
  flex: 1;
  height: 88rpx;
  border: none;
  background: transparent;
  padding: 0;
  font-size: 30rpx;
  color: #2d3748;
}

.eye-btn {
  padding: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  cursor: pointer;
}

.pwd-placeholder {
  color: #a0aec0;
}

.btn-unlock {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

/* 文本编辑器容器 */
.editor-wrapper {
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid #edf2f7;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 20rpx;
  display: flex;
  flex-direction: column;
}

textarea {
  width: 100%;
  height: 380rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #2d3748;
  box-sizing: border-box;
}

.word-counter {
  align-self: flex-end;
  font-size: 22rpx;
  color: #a0aec0;
  margin-top: 10rpx;
}

/* 加密保护设置栏 */
.encrypt-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #edf2f7;
}

.encrypt-toggle-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.encrypt-label-group {
  display: flex;
  flex-direction: column;
}

.encrypt-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3748;
}

.encrypt-tip {
  font-size: 20rpx;
  color: #718096;
  margin-top: 4rpx;
}

.encrypt-inputs {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  border-top: 1rpx solid #f0f4f8;
  padding-top: 20rpx;
}

.pwd-field {
  flex: 1;
  height: 80rpx;
  border: none;
  background: transparent;
  padding: 0;
  font-size: 28rpx;
  color: #2d3748;
}

.encrypt-inputs .pwd-input-wrap {
  margin-bottom: 0;
  height: 80rpx;
  padding: 0 12rpx 0 20rpx;
}

/* 广告组件 */
ad-custom {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 底部操作按钮 */
#btn-container {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
  padding-bottom: 30rpx;
}

#btn-paste {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  background-color: #e2e8f0;
  color: #2d3748;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  margin: 0;
  padding: 0;
}

#btn-save {
  flex: 1.2;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  margin: 0;
  padding: 0;
}
